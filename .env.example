# Copiar como .env para desarrollo local y reemplazar los valores de ejemplo.
# El archivo .env esta ignorado por Git y no debe subirse al repositorio.

MYSQL_DATABASE=loteriavirtual
MYSQL_ROOT_PASSWORD=cambiar-por-una-clave-local-segura

JWT_KEY=cambiar-por-una-clave-larga-aleatoria-y-segura
JWT_ISSUER=LoteriaVirtualAPI
JWT_AUDIENCE=UsuariosDeLoteria

# Opcional: solo para crear el primer administrador en un entorno nuevo.
# Si no se configuran ambas variables, la aplicación no debe crear un admin automáticamente.
BOOTSTRAP_ADMIN_USERNAME=admin_local
BOOTSTRAP_ADMIN_PASSWORD=cambiar-por-una-clave-segura
